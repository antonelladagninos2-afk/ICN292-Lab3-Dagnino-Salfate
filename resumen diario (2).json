      "name": "Get row(s)"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst total = items.length;\n\nconst porRuta = {};\nlet montoTotalDia = 0;\nlet aprobados = 0;\n\nfor (const item of items) {\n  const d = item.json;\n  const ruta = d.ruta || 'SIN_RUTA';\n  porRuta[ruta] = (porRuta[ruta] || 0) + Number(d.monto || 0);\n  montoTotalDia += Number(d.monto || 0);\n  if (d.estado_final === 'aprobado') aprobados++;\n}\n\nconst tasaAprobacion = total > 0 ? ((aprobados / total) * 100).toFixed(1) : 0;\n\nconst detalleRutas = Object.entries(porRuta)\n  .map(([ruta, monto]) => `${ruta}: $${monto.toLocaleString('es-CL')}`)\n  .join(' | ');\n\nconst mensaje = `Resumen del día: ${total} solicitudes procesadas. Monto total: $${montoTotalDia.toLocaleString('es-CL')}. Por ruta: ${detalleRutas}. Tasa de aprobación automática: ${tasaAprobacion}%.`;\n\nreturn [{ json: {\n  total_solicitudes: total,\n  monto_total_dia: montoTotalDia,\n  monto_por_ruta: porRuta,\n  tasa_aprobacion: Number(tasaAprobacion),\n  mensaje\n} }];;"
      },
